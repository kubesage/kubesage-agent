# Phase 20.5 — direnv config for containerization compliance.
# Loaded automatically by direnv when entering this repo dir.
#
# Prepends ./bin to PATH so raw `pnpm` / `go` typed at the shell
# resolves to the wrapper, which blocks host-side install/build/dev/test.
#
# Run `direnv allow` once after cloning the repo to enable.
# Without direnv installed: source .envrc manually, or use Make targets
# which dispatch to docker compose directly.

PATH_add ./bin

# Document the bypass mechanism in shell history when activated.
if [[ -n "${KUBESAGE_ALLOW_HOST:-}" ]]; then
  echo "⚠ KUBESAGE_ALLOW_HOST is set — host-side npm/pnpm/go invocations bypass the supply-chain rule." >&2
fi
